import os
from flask import Flask
import telebot

TOKEN = os.getenv("BOT_TOKEN", "9068039553:AAH...") # أو ضعي التوكن الخاص بكِ مباشرة هنا
bot = telebot.TeleBot(TOKEN)

app = Flask(__name__)

@app.route('/')
def home():
    return "Bot is active!"

@bot.message_handler(commands=['start'])
def send_welcome(message):
    bot.reply_to(message, "أهلاً بكِ! البوت يعمل بنجاح 24/7.")

if __name__ == "__main__":
    # تشغيل سيرفر فلاسك في الخلفية مع البوت
    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", 5000))
